extends "res://tests/test_ui.gd"
const Rules = preload("res://scripts/rules.gd")

func wait_coach():
	var deadline: int = Time.get_ticks_msec() + 330000
	while app.coach.busy and Time.get_ticks_msec() < deadline:
		await create_timer(0.1).timeout
	await settle()
	check(not app.coach.busy and app.coach.error.is_empty(), "real coach request completes: " + app.coach.error)
	if app.coach.busy or not app.coach.error.is_empty():
		printerr("FAIL UI: native coach unavailable, aborting dependent checks")
		quit(1)

func run():
	root.size = Vector2i(1440,900)
	app = Main.new()
	app.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	root.add_child(app)
	await settle()
	check(app.find_child("home_coach",true,false).get_global_rect().end.y < app.right_panel.get_global_rect().end.y, "coach entry visible without scrolling on home")
	check(app.right.size.y <= app.right.get_parent().size.y+1, "four home entries and progress fit their panel")
	await capture("01-home")
	app.game.play(60)
	var match_before: Dictionary = app.game.to_data().duplicate(true)
	await click_button(app.find_child("home_coach",true,false))
	check(app.section == "coach" and app.coach.game.size == 9, "home has real dedicated coach entry")
	check(app.board_view.top_view and app.current() == app.coach.game, "coach defaults top down with separate practice")
	app.coach.level = 0
	await capture("15-coach-start")
	await click_point(0)
	await wait_coach()
	check(app.coach.proposal == 0 and app.coach.mine.point == 0, "real clicked point is forced for native comparison")
	check(app.coach.game.moves.is_empty() and app.game.to_data() == match_before, "selecting and evaluating mutate neither practice nor match")
	check(app.find_child("coach_comparison",true,false) != null, "comparison visible")
	validate_layout()
	await capture("16-coach-comparison")
	await click_button(app.find_child("coach_best_line",true,false))
	check(app.coach.preview != null and app.coach.step == 1, "open actual KataGo principal variation")
	var count: int = mini(4,app.coach.line.size())
	for i in range(1,count): await click_button(app.find_child("coach_next",true,false))
	check(app.coach.step == count and app.coach.game.moves.is_empty(), "step through native PV without committing")
	await capture("17-coach-variation")
	for i in range(count): await click_button(app.find_child("coach_previous",true,false))
	check(app.coach.step == 0 and app.coach.preview.board == app.coach.game.board, "rewind to real starting position")
	await click_button(app.find_child("coach_return",true,false))
	await click_button(app.find_child("coach_my_line",true,false))
	check(app.coach.line[0] == 0 and app.coach.preview.board[0] == 1, "inspect own variation, not AI's alternate")
	await click_button(app.find_child("coach_return",true,false))
	await click_button(app.find_child("coach_adopt_mine",true,false))
	await wait_coach()
	check(app.coach.game.moves.size() == 2 and app.coach.game.moves[0].point == 0 and app.coach.game.turn == 1, "adoption and actual AI reply start next learning turn")
	await click_button(app.find_child("coach_undo",true,false))
	check(app.coach.game.moves.is_empty(), "coach undo returns one full turn")
	await click_button(app.find_child("coach_pass",true,false))
	await wait_coach()
	check(app.coach.mine.point == -1 and app.coach.mine.pv[0] == -1, "native engine evaluates human pass, no fake board coordinate")
	await click_button(app.find_child("coach_adopt_mine",true,false))
	await wait_coach()
	check(app.coach.game.moves[0].point == -1, "adopted pass recorded accurately")
	await click_button(app.find_child("coach_restart",true,false))
	var dialog: ConfirmationDialog = app.find_child("coach_new_dialog",true,false)
	check(dialog != null and dialog.visible, "restart available before game ends")
	await click_at(Vector2(dialog.position) + dialog.get_ok_button().get_global_rect().get_center())
	check(app.coach.game.moves.is_empty() and app.game.to_data() == match_before, "restart clears practice only")
	app.coach.recommend()
	await settle()
	await click_button(app.nav_buttons.play)
	await create_timer(0.8).timeout
	check(not app.coach.busy and not app.coach.active and app.game.to_data() == match_before, "leaving during analysis cancels safely")
	await click_button(app.nav_buttons.coach)
	await click_button(app.find_child("coach_settings",true,false))
	await click_button(app.find_child("coach_size_19",true,false))
	check(app.coach.game.size == 19, "19x19 coach selectable")
	# Legal nontrivial position, force the other color for perspective coverage.
	app.coach.game = app.Coach.clone(app.home_preview)
	app.coach.game.play(0)
	app.coach.human = 2
	app.coach.recommend()
	await wait_coach()
	check(app.coach.best.pv.size() > 1 and app.coach.game.turn == 2, "real white-to-play analysis on 19x19")
	app.coach.choose(1)
	await wait_coach()
	check(app.coach.mine.point == 1, "real white restricted-root analysis")
	await capture("18-coach-midgame")
	root.size = Vector2i(1100,720)
	await settle()
	validate_layout()
	await capture("19-coach-small-window")
	# Persist only the real training game, not analysis diagrams.
	app.coach.show_line("best")
	app.save_path = "res://.runtime/coach-save-fixture.json"
	app.test_mode = false
	app._save()
	var saved = JSON.parse_string(FileAccess.get_file_as_string(app.save_path))
	check(saved.coach_game.moves.size() == app.coach.game.moves.size() and saved.game.moves.size() == 1, "save both sessions separately without PV moves")
	app.coach.game = Rules.new(9)
	app._load_save()
	check(app.coach.game.moves.size() == 33 and app.coach.human == 2 and app.coach.level == 0, "practice history and settings restore")
	app.test_mode = true
	app.coach.clear_analysis()
	app.coach.game = Rules.new(9)
	app.coach.human = 1
	app.coach.game.play(40)
	app.coach.game.pass_turn()
	app.coach.game.pass_turn()
	app.coach.changed.emit()
	await settle()
	await click_point(40)
	check(app.coach.game.dead.has(40), "coach scoring allows marking dead groups by mouse")
	await click_button(app.find_child("coach_approve_1",true,false))
	check(app.coach.game.phase == "scoring", "one approval does not end coaching game")
	await click_button(app.find_child("coach_approve_2",true,false))
	check(app.coach.game.phase == "finished", "coach ends only after both score approvals")
	await click_button(app.find_child("coach_restart",true,false))
	check(app.coach.game.phase == "play" and app.coach.game.moves.is_empty(), "finished practice restarts directly")
	var pid: int = app.katago.process.get("pid",0)
	app.queue_free()
	await settle()
	check(pid == 0 or not OS.is_process_running(pid), "coach closes its shared engine on exit")
	var file = FileAccess.open("res://evidence/coach-ui-results.json",FileAccess.WRITE)
	file.store_string(JSON.stringify({"checks":checks,"failures":failures,"render":render},"  "))
	print("COACH UI: %d checks, %d failures" % [checks,failures.size()])
	quit(1 if not failures.is_empty() else 0)
